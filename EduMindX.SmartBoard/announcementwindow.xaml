<Window x:Class="EduMindX.SmartBoard.AnnouncementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EduMindX Duyuru" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="#D90B1220" Topmost="True" ShowInTaskbar="False" FontFamily="Segoe UI" xmlns:smartboard="clr-namespace:EduMindX.SmartBoard;assembly=EduMindX.SmartBoard" KeyDown="Window_KeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#111827" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="#FEE100" CornerRadius="16" Padding="48,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="Card" Background="#111827" BorderBrush="#FEE100" BorderThickness="3" CornerRadius="24" Padding="56,40" MaxWidth="1400" Margin="48" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Duyuru" FontSize="30" FontWeight="SemiBold" Foreground="#FEE100" HorizontalAlignment="Center" />
      <ScrollViewer Grid.Row="1" Margin="0,24,0,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <TextBlock Name="MessageText" FontSize="44" Foreground="#FFFFFFFF" TextWrapping="Wrap" TextAlignment="Center" />
      </ScrollViewer>
      <TextBlock Name="SentAtText" Grid.Row="2" FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,24" />
      <Button Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="Tamam" Height="64" MinWidth="220" HorizontalAlignment="Center" Click="Ok_Click" />
    </Grid>
  </Border>
</Window>